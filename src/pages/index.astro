---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const profileEntry = await getEntry('pages', 'about');
if (!profileEntry) throw new Error('About profile content is missing.');
const profile = profileEntry.data;
const projects = (await getCollection('projects', ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order);
---
<PageLayout>
	<main>
		<section class="hero" aria-labelledby="home-heading">
			<div>
				<span class="eyebrow">배움과 프로젝트 기록</span>
				<h1 id="home-heading">배운 것을 정리하고,<br /><em>만든 것을 기록합니다.</em></h1>
				<p>공부와 프로젝트를 진행하며 알게 된 내용, 해결 과정, 다음에 더 알아볼 질문을 기록하는 공간입니다.</p>
				<div class="action-row">
					<a class="action primary" href="/blog">기록 읽기 ↗</a>
					<a class="action secondary" href="https://github.com/holymo-ly" target="_blank" rel="noopener noreferrer">GitHub 보기 ↗</a>
				</div>
			</div>
			<aside class="terminal" aria-label="참가 경험">
				<div class="terminal-head">ACTIVITIES / 2026</div>
				<div class="terminal-body">
					<p><span class="muted">$</span> 참가 경험</p>
					{profile.activities.map((activity) => <p><span class="accent">·</span> {activity}</p>)}
				</div>
			</aside>
		</section>

		<section class="section" aria-labelledby="latest-heading">
			<div class="section-head">
				<div><span class="eyebrow">최근 기록</span><h2 id="latest-heading">새 글</h2></div>
				<a href="/blog">모든 글 보기 ↗</a>
			</div>
			{posts.length ? (
				<div class="post-list">
					{posts.map((post) => (
						<a class="post-item" href={`/blog/${post.id}/`}>
							<div><span class="post-category">{post.data.category}</span><strong>{post.data.title}</strong><p>{post.data.description}</p></div>
							<small>{post.data.pubDate.toLocaleDateString('ko-KR')}</small>
						</a>
					))}
				</div>
			) : (
				<div class="empty-state">아직 공개한 글이 없습니다. 첫 글을 추가하면 여기에 표시됩니다.</div>
			)}
		</section>

		<section class="section" id="projects" aria-labelledby="projects-heading">
			<div class="section-head">
				<div><span class="eyebrow">함께 만들고 있는 것</span><h2 id="projects-heading">프로젝트</h2></div>
				<a href="/projects/">프로젝트 전체 보기 ↗</a>
			</div>
			<div class="topic-grid">
				{projects.slice(0, 2).map((project, index) => (
					<article class="topic-card">
						<span class="topic-number">0{index + 1} / {project.data.status.toUpperCase()}</span>
						<h2>{project.data.title}</h2>
						<p>{project.data.description}</p>
						<p class="project-role">{project.data.role}</p>
						{project.data.repoUrl && <a class="project-link" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">공개 저장소 보기 ↗</a>}
					</article>
				))}
			</div>
		</section>

		<section class="section author-card" aria-labelledby="author-heading">
			<div>
				<span class="eyebrow">About the author</span>
				<h2 id="author-heading">{profile.name} <span>/ {profile.englishName}</span></h2>
				<p>{profile.school} {profile.major} {profile.position}</p>
			</div>
			<a class="action secondary" href="/about/">소개와 활동 이력 ↗</a>
		</section>
	</main>
</PageLayout>
<style>
	.topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; }
	.topic-card { border: 1px solid var(--border); border-radius: 11px; padding: 23px; background: var(--card); }
	.topic-number { display: block; margin-bottom: 12px; color: #90c6a6; font: 11px ui-monospace, Menlo, monospace; }
	.topic-card h2 { font-size: 19px; margin-bottom: 9px; }
	.topic-card p { color: var(--muted); font-size: 14px; }
	.topic-card .project-role { margin-top: 11px; color: #92c9a1; font-size: 12px; }
	.project-link { display: inline-block; margin-top: 10px; color: var(--accent); font-size: 13px; font-weight: 700; }
	.post-category { display: block; margin-bottom: 6px; color: var(--accent); font-size: 11px; font-weight: 800; }
	.author-card { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 27px; border: 1px solid var(--border); border-radius: 12px; background: #14232b; }
	.author-card h2 { margin: 9px 0; font-size: 25px; }
	.author-card h2 span { color: var(--muted); font-size: 17px; font-weight: 500; }
	.author-card p { color: var(--muted); font-size: 14px; }
	@media (max-width: 720px) { .topic-grid { grid-template-columns: 1fr; } }
	@media (max-width: 620px) { .author-card { flex-direction: column; align-items: flex-start; } }
</style>
