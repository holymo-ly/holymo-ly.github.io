---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<PageLayout title={`블로그 | ${SITE_TITLE}`} description="공부와 프로젝트를 진행하며 배운 내용을 기록합니다.">
	<main>
		<header class="page-header">
			<span class="eyebrow">학습 · 프로젝트 · 회고</span>
			<h1>블로그</h1>
			<p class="page-lead">배운 내용과 작업 과정을 기록합니다. 아직 공개한 글이 없으면 첫 글을 추가한 뒤 이곳에서 확인할 수 있어요.</p>
		</header>
		<section aria-label="블로그 글 목록">
			{posts.length ? (
				<div class="post-list">
					{posts.map((post) => (
						<a class="post-item" href={`/blog/${post.id}/`}>
							<div><span class="post-category">{post.data.category}</span><strong>{post.data.title}</strong><p>{post.data.description}</p></div>
							<small>{post.data.pubDate.toLocaleDateString('ko-KR')}</small>
						</a>
					))}
				</div>
			) : (
				<p class="empty-state">아직 공개한 글이 없습니다.</p>
			)}
		</section>
	</main>
</PageLayout>
<style>
	.post-category { display: block; margin-bottom: 6px; color: var(--accent); font-size: 11px; font-weight: 800; }
</style>
